# Backend environment variables
# Copy this to .env and fill in production values

# REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-secret-key-change-this-in-production

# REQUIRED in production if you don't set this, requests will raise on startup
FLASK_ENV=production

# Optional: Postgres connection string for production (falls back to local SQLite if unset)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: restrict CORS to your deployed frontend (falls back to "*" if unset)
# FRONTEND_URL=https://your-frontend.vercel.app
